# Copy this file to your own local env file on the Mac build machine.
# Fill in the values before running a signed/notarized macOS build.

# Required for notarization
APPLE_ID=your-apple-id@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# Required for code signing if the certificate is not already installed in Keychain
# CSC_LINK=file:///absolute/path/to/Developer_ID_Application.p12
# CSC_KEY_PASSWORD=your-p12-password

# Optional override if you want to force identity selection
# CSC_NAME=Developer ID Application: Your Name (TEAMID)
